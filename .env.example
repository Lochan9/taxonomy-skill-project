# Copy to .env and fill in locally. Never commit .env.
# Placeholders only — no real values belong in this file.

# --- Job postings ---
# Greenhouse Job Board API GET endpoints are public and need no key.
GREENHOUSE_BASE_URL=https://boards-api.greenhouse.io/v1/boards
# Contact string sent in the User-Agent header when calling public APIs
HTTP_USER_AGENT=your-team-name-capstone (contact: your-email@example.edu)

# --- LLM providers (optional; only if the pipeline uses an LLM) ---
LLM_PROVIDER=gemini            # gemini | anthropic | github | groq | openrouter | ollama
# University-provided Anthropic API access
ANTHROPIC_API_KEY=
GEMINI_API_KEY=your-gemini-api-key-here
GITHUB_MODELS_TOKEN=your-github-token-here
GROQ_API_KEY=your-groq-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here
OLLAMA_HOST=http://localhost:11434

# --- Storage ---
# Local development database only. The shared database engine/location is pending
# agreement with Section A (see docs/data_contract.md, D3).
LOCAL_DATABASE_PATH=data/processed/local_dev.duckdb
